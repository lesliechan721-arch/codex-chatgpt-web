# VNC_PASSWORD and KEYRING_PASSWORD are intentionally not stored in this file.
# Export both values in the shell that runs Docker Compose.

# Existing reverse proxy connects to these host-loopback ports.
NOVNC_HOST_PORT=6080
RESPONSES_HOST_PORT=17841

# Public HTTPS /v1 Base URL for Codex on another machine. Leave empty when Codex runs on this host.
CODEX_PUBLIC_BASE_URL=https://server.example.com/v1

# Path on the external Codex machine where the exported model catalog will be copied.
CODEX_CLIENT_CATALOG_PATH=~/.codex/api-key-models.json

# Server-deployment-only maximum idle period without real native-turn progress.
REMOTE_TURN_IDLE_TIMEOUT_SEC=600
